{
  "name": "nip-gm-nostr",
  "version": "0.0.0",
  "description": "Transport and Signer bindings for NIP-GM over NDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "nip-gm-core": "workspace:*"
  },
  "peerDependencies": {
    "@nostr-dev-kit/ndk": "2.15.2"
  },
  "devDependencies": {
    "@nostr-dev-kit/ndk": "2.15.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
